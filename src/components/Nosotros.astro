---
---
<section id="nosotros" class="py-28 px-6 bg-bg relative overflow-hidden">

  <!-- Decorativos -->
  <div class="absolute top-0 right-0 w-72 h-72 opacity-5"
    style="background: radial-gradient(circle, #1B4D1E, transparent 70%);">
  </div>

  <div class="max-w-6xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-20 items-center">

      <!-- Imagen con parallax -->
      <div class="relative" id="nosotros-img-wrap">
        <!-- Marco desplazado -->
        <div class="absolute -top-4 -left-4 right-4 bottom-4 border border-gold/25"></div>

        <img
          id="nosotros-img"
          src="/images/nosotros.jpg"
          alt="Restaurante Cordillera del Sabor"
          class="w-full h-[480px] object-cover shadow-2xl relative z-10 grayscale-[15%]"
        />

        <!-- Badge flotante -->
        <div class="absolute -bottom-6 -right-6 bg-dark text-off-white z-20 shadow-2xl px-6 py-4 border-l-2 border-gold">
          <p class="font-script text-2xl text-gold leading-none">Tradición</p>
          <p class="font-body text-[10px] text-off-white/50 uppercase tracking-widest mt-1">Colombiana</p>
        </div>
      </div>

      <!-- Texto editorial -->
      <div id="nosotros-text">
        <h2 class="font-serif text-5xl md:text-6xl text-dark font-normal italic mb-2 leading-tight">
          Nuestra<br/>Historia
        </h2>
        <span class="heading-rule block mb-10"></span>

        <!-- Pull quote -->
        <blockquote class="border-l border-gold/40 pl-6 mb-8">
          <p class="font-serif italic text-dark-mid text-xl leading-relaxed">
            "Desde las alturas de la Cordillera traemos los sabores más auténticos de Colombia a tu mesa."
          </p>
        </blockquote>

        <p class="font-body text-dark/70 text-sm leading-loose mb-10">
          En el corazón del Barrio Madelena, cada plato es una celebración de nuestra cultura
          y tradición culinaria. Nuestros ingredientes son frescos, nuestras recetas son heredadas
          y nuestra pasión por la cocina colombiana hace que cada visita sea una experiencia
          inolvidable. Desde la sopa de cebada hasta la Bandeja Paisa, cada bocado cuenta una historia.
        </p>

        <!-- Stats -->
        <div class="grid grid-cols-2 gap-6">
          <div class="pt-6 border-t border-dark/15">
            <p class="font-serif text-5xl text-primary font-normal">100%</p>
            <p class="font-body text-[10px] text-dark/50 uppercase tracking-widest mt-2">Ingredientes frescos</p>
          </div>
          <div class="pt-6 border-t border-dark/15">
            <p class="font-serif text-5xl text-accent font-normal italic">Sabor</p>
            <p class="font-body text-[10px] text-dark/50 uppercase tracking-widest mt-2">Hecho con amor</p>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  gsap.registerPlugin(ScrollTrigger)

  gsap.to('#nosotros-img', {
    yPercent: -8,
    ease: 'none',
    scrollTrigger: {
      trigger: '#nosotros',
      start: 'top bottom',
      end: 'bottom top',
      scrub: true,
    },
  })

  gsap.from('#nosotros-text', {
    opacity: 0,
    x: 40,
    duration: 1,
    ease: 'power3.out',
    scrollTrigger: {
      trigger: '#nosotros',
      start: 'top 70%',
      toggleActions: 'play none none reverse',
    },
  })

  gsap.from('#nosotros-img-wrap', {
    opacity: 0,
    x: -40,
    duration: 1,
    ease: 'power3.out',
    scrollTrigger: {
      trigger: '#nosotros',
      start: 'top 70%',
      toggleActions: 'play none none reverse',
    },
  })
</script>
