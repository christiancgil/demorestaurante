---
const testimonios = [
  {
    nombre: 'María Rodríguez',
    texto: 'El menú del día es una delicia. La sopa de cebada me recuerda a la comida de mi abuela. Siempre vuelvo.',
    iniciales: 'MR',
    color: 'bg-primary',
  },
  {
    nombre: 'Carlos Gómez',
    texto: 'La Bandeja Paisa es impresionante, abundante y deliciosa. El mejor restaurante del barrio, sin duda.',
    iniciales: 'CG',
    color: 'bg-accent',
  },
  {
    nombre: 'Luisa Martínez',
    texto: 'El churrasco especial es espectacular. Los domicilios llegan perfectos y a tiempo. Recomendadísimo.',
    iniciales: 'LM',
    color: 'bg-gold',
  },
]
---
<section id="testimonios" class="py-28 px-6 bg-dark relative overflow-hidden">

  <!-- Imagen fondo parallax (lado derecho) -->
  <div id="test-food-wrap" class="absolute right-0 top-0 bottom-0 w-5/12 overflow-hidden hidden lg:block">
    <img
      id="test-food-img"
      src="/images/food-1.jpg"
      alt=""
      class="w-full h-full object-cover scale-110"
    />
    <!-- Degradado hacia la izquierda -->
    <div class="absolute inset-0" style="background: linear-gradient(to right, #1A0D08, transparent 60%);"></div>
  </div>

  <div class="max-w-6xl mx-auto relative z-10">
    <div class="lg:max-w-lg">

      <h2 class="font-serif text-5xl md:text-6xl text-off-white font-normal italic mb-3">
        Nuestros<br/>Clientes
      </h2>
      <span class="heading-rule block mb-16"></span>

      <div class="space-y-6">
        {testimonios.map((t) => (
          <div class="testimonio-card relative group">
            <!-- Comilla decorativa -->
            <div class="absolute -top-3 -left-1 quote-mark select-none" aria-hidden="true">"</div>

            <div class="pt-6 pb-6 border-b border-off-white/10">
              <p class="font-serif italic text-off-white/75 text-base leading-relaxed mb-5 pl-2">
                {t.texto}
              </p>
              <div class="flex items-center gap-4 pl-2">
                <div class={`${t.color} w-8 h-8 flex items-center justify-center font-body font-bold text-white text-xs flex-shrink-0`}>
                  {t.iniciales}
                </div>
                <div>
                  <p class="font-body text-off-white/80 text-sm font-bold tracking-wide">{t.nombre}</p>
                  <div class="flex gap-0.5 mt-0.5">
                    {[1,2,3,4,5].map(() => (
                      <span class="text-gold text-[10px]">★</span>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  gsap.registerPlugin(ScrollTrigger)

  gsap.to('#test-food-img', {
    yPercent: 15,
    ease: 'none',
    scrollTrigger: {
      trigger: '#testimonios',
      start: 'top bottom',
      end: 'bottom top',
      scrub: true,
    },
  })

  gsap.from('.testimonio-card', {
    opacity: 0,
    x: -30,
    stagger: 0.2,
    duration: 0.9,
    ease: 'power3.out',
    scrollTrigger: {
      trigger: '#testimonios',
      start: 'top 70%',
      toggleActions: 'play none none reverse',
    },
  })
</script>
