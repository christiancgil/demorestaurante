---
const platos = [
  {
    categoria: 'Ejecutivos',
    precio: '$18.000',
    items: ['Carne asada', 'Lomo', 'Pechuga', 'Bistec a caballo', 'Costilla dorada BBQ'],
    accent: '#1B4D1E',
    tag: 'Diario',
  },
  {
    categoria: 'Especiales',
    precio: '$26.000',
    items: ['Churrasco', 'Mojarra', 'Pechuga gratinada'],
    accent: '#C0392B',
    tag: 'Selección',
  },
  {
    categoria: 'Bandejas',
    precio: '$31.000',
    items: ['Bandeja Paisa', 'Bandeja 3 carnes'],
    accent: '#B8860B',
    tag: 'Tradición',
  },
]
---
<section id="a-la-carta" class="py-28 px-6 bg-dark relative overflow-hidden">

  <!-- Textura de fondo sutil -->
  <div class="absolute inset-0 opacity-[0.03]"
    style="background-image: repeating-linear-gradient(45deg, #F5EDD6 0, #F5EDD6 1px, transparent 0, transparent 50%); background-size: 24px 24px;">
  </div>

  <!-- Decorativo: arco de luz superior -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-96 h-32 opacity-10"
    style="background: radial-gradient(ellipse at top, #B8860B, transparent 70%);">
  </div>

  <div class="max-w-6xl mx-auto relative z-10">
    <div class="text-center mb-20">
      <h2 class="font-serif text-5xl md:text-6xl text-off-white font-normal italic mb-3">A la Carta</h2>
      <span class="heading-rule mx-auto block"></span>
    </div>

    <div id="cartas-grid" class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {platos.map((plato) => (
        <div
          class="carta-card group relative bg-off-white/[0.04] hover:bg-off-white/[0.07] transition-[background-color] duration-300 overflow-hidden"
          style={`border-top: 2px solid ${plato.accent};`}
        >
          <!-- Categoría -->
          <div class="px-8 pt-8 pb-6 border-b border-off-white/10">
            <h3 class="font-serif text-3xl text-off-white font-normal italic">{plato.categoria}</h3>
          </div>

          <!-- Items -->
          <ul class="px-8 py-6 space-y-3">
            {plato.items.map(item => (
              <li class="font-body text-off-white/60 text-sm flex items-baseline gap-3">
                <span class="w-3 h-px flex-shrink-0 mt-2" style={`background: ${plato.accent}; opacity: 0.5;`}></span>
                {item}
              </li>
            ))}
          </ul>

          <!-- Precio -->
          <div class="px-8 pb-8 pt-2">
            <div class="h-px w-full mb-6" style="background: rgba(255,255,255,0.06);"></div>
            <p class="font-script text-5xl leading-none" style={`color: ${plato.accent === '#B8860B' ? '#D4AA30' : plato.accent === '#1B4D1E' ? '#4ade80' : '#f87171'};`}>
              {plato.precio}
            </p>
          </div>

          <!-- Hover glow -->
          <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"
            style={`background: radial-gradient(ellipse at center, ${plato.accent}10, transparent 70%);`}>
          </div>
        </div>
      ))}
    </div>

    <div class="text-center mt-14">
      <a
        href="https://wa.me/573103775506?text=Hola,%20quiero%20ver%20el%20men%C3%BA%20a%20la%20carta"
        target="_blank"
        rel="noopener"
        class="cta-press inline-flex items-center gap-3 border border-gold/40 hover:border-gold text-gold hover:bg-gold hover:text-dark font-body uppercase tracking-[0.25em] text-xs px-10 py-4 transition-[background-color,border-color,color] duration-150"
      >
        Consultar por WhatsApp
      </a>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  gsap.registerPlugin(ScrollTrigger)

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches

  gsap.set('#a-la-carta .heading-rule', { scaleX: 0, transformOrigin: 'center' })
  gsap.to('#a-la-carta .heading-rule', {
    scaleX: 1, duration: 0.7, ease: 'power3.out',
    scrollTrigger: { trigger: '#a-la-carta', start: 'top 75%', toggleActions: 'play none none reverse' },
  })

  gsap.from('.carta-card', {
    opacity: 0,
    y: reduced ? 0 : 40,
    stagger: 0.12,
    duration: 0.65,
    ease: 'power3.out',
    scrollTrigger: {
      trigger: '#a-la-carta',
      start: 'top 70%',
      toggleActions: 'play none none reverse',
    },
  })
</script>
